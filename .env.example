# GEMINI API KEY (Tuỳ chọn cho tính năng AI viết mô tả sản phẩm)
GEMINI_API_KEY="your-gemini-api-key-here"

# MONGO DB CONNECTION URI (MongoDB Atlas hoặc MongoDB Local)
# Ví dụ Cloud MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/fashionpro?retryWrites=true&w=majority
MONGODB_URI="mongodb://127.0.0.1:27017/fashionpro"

# PORT CỔNG SERVER (Mặc định 3000)
PORT=3000

# NODE ENV (development / production)
NODE_ENV="development"
